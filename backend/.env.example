# Application
APP_NAME="Real-Time Streaming Gateway"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=streaming_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=gateway:events

# WebSocket Heartbeat
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=10
